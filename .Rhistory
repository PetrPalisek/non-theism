hypothesis <-  "h1a_ + h1b_ + h1c_ + ms1_big3 + ms1_big4 < 0"
H1_base <- restriktor::goric(base_mi_params[["est"]], VCOV = base_mi_params[["VCOV"]],
hypotheses = list(hypothesis), comparison = "complement")
benchmark(H1_base)
